class Solution:
    def fizzBuzz(self, n: int) -> list[str]:
        result = []
        for x in range(1, n + 1):
            if x % 3 == 0 and x % 5 != 0:
                result.append("Fizz")
            elif x % 5 == 0 and x % 3 != 0:
                result.append("Buzz")
            elif x % 3 == 0 and x % 5 == 0:
                result.append("FizzBuzz")
            else:
                x = str(x)
                result.append(x)
        return result
